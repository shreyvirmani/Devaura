# ==============================================================================
# Devaura Environment Configuration (Placeholders Only — Never Commit .env)
# ==============================================================================

# Mode: local_development | local_production | staging | production
APP_ENV=local_production
LOG_LEVEL=INFO

# Security (REQUIRED: 32+ random characters; default dev key is rejected in local_production)
SECRET_KEY=replace-with-32-plus-char-random-secret-key
ALLOW_DEV_USER_FALLBACK=false

# Server & CORS (explicit origins required in local_production; '*' is rejected)
API_HOST=127.0.0.1
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL is mandatory in local_production)
DATABASE_URL=postgresql+asyncpg://devaura:replace-with-db-password@localhost:5432/devaura

# Independent Durable Worker (keep WORKER_ENABLED=false on API in local_production)
WORKER_ENABLED=false
WORKER_POLL_INTERVAL_SECONDS=2.0
JOB_LEASE_DURATION_SECONDS=300
JOB_MAX_ATTEMPTS=3

# GitHub App (REQUIRED in local_production; never use a PAT as a replacement)
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-with-private-key\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret

# LLM Provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key

# Sandbox Configuration
SANDBOX_BACKEND=local
SANDBOX_TIMEOUT_SECONDS=120

# Frontend Public Configuration (NEVER place backend secrets in NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local_production
