# ==============================================================================
# Devaura Environment Configuration
# ==============================================================================

# Application & Environment
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-devaura-secret-key-32chars
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./devaura.db
# For PostgreSQL in Docker / Production:
# DATABASE_URL=postgresql+asyncpg://devaura:devaura_password@localhost:5432/devaura

# LLM Providers
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub Integration
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Model Context Protocol (MCP) Configuration
MCP_SERVER_CONFIG=config/mcp_servers.json
MCP_CONNECT_TIMEOUT_MS=15000
MCP_TOOL_TIMEOUT_MS=60000

# Sandbox Configuration
SANDBOX_BACKEND=local
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=2048m
SANDBOX_TIMEOUT_SECONDS=120

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
